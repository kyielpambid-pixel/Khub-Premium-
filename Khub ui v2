## 5. FILL TAB (do blocks)

```lua
do
	TabMain:Section("FARM")

	TabMain:Toggle({
		Name = "Auto Farm",
		CurrentValue = false,
		Flag = "AutoFarm",
		Callback = function(v)
			-- v = true / false
		end,
	})

	TabMain:Slider({
		Name = "Delay",
		Min = 0.1,
		Max = 5,
		Default = 1,
		Increment = 0.1,
		Flag = "FarmDelay",
		Callback = function(v) end,
	})

	TabMain:Dropdown({
		Name = "Mode",
		Options = { "A", "B", "C" },
		CurrentOption = "A",
		Flag = "Mode",
		Callback = function(opt) end,
	})

	TabMain:Button({
		Name = "Run Once",
		Callback = function()
			uiNotify("Done", "Clicked", true)
		end,
	})

	TabMain:Label({ Text = "Any helper text" })

	TabMain:Paragraph({
		Title = "Info",
		Content = "Longer description.",
	})
end
```

