## 3. CREATE WINDOW

```lua
local Window = Library:CreateWindow({
	Name = "KHUB_MyScript",
	Title = "KHUB · My Game",          -- always = game name
	Keybind = Enum.KeyCode.RightShift,
	Size = UDim2.fromOffset(620, 480),
	ConfigurationSaving = {
		FolderName = "KHUB_MyScript_Configs",
		FileName = "default",
	},
})

local function uiNotify(title, content, success)
	pcall(function()
		Window:Notify({
			Title = title or "KHUB",
			Content = content or "",
			Type = success and "Success" or "Warning",
			Duration = 3,
		})
	end)
end
```

