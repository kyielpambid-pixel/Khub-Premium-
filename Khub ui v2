## 1. INTRO (copy this block every script)

Play **before** the main UI. User can press **SKIP**. Sound starts at second 10.

```lua
--------------------------------------------------------------------
-- KHUB INTRO (same as Timebomb Premium / Dandy's World)
--------------------------------------------------------------------
local function playKHUBIntro()
	local Players = game:GetService("Players")
	local TweenService = game:GetService("TweenService")
	local Lighting = game:GetService("Lighting")
	local SoundService = game:GetService("SoundService")

	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	-- cleanup old
	pcall(function()
		local old = playerGui:FindFirstChild("KHUBIntro")
		if old then old:Destroy() end
	end)

	local MAIN_COLOR = Color3.fromRGB(157, 78, 221)
	local WHITE = Color3.fromRGB(255, 255, 255)
	local SOUND_ID = 120267378058133

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "KHUBIntro"
	screenGui.IgnoreGuiInset = true
	screenGui.ResetOnSpawn = false
	screenGui.DisplayOrder = 999999
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.Parent = playerGui

	local darkOverlay = Instance.new("Frame")
	darkOverlay.Size = UDim2.fromScale(1, 1)
	darkOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	darkOverlay.BackgroundTransparency = 1
	darkOverlay.BorderSizePixel = 0
	darkOverlay.Parent = screenGui

	local overlay = Instance.new("Frame")
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundColor3 = Color3.fromRGB(8, 4, 16)
	overlay.BackgroundTransparency = 1
	overlay.BorderSizePixel = 0
	overlay.Parent = screenGui

	local mainLabel = Instance.new("TextLabel")
	mainLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	mainLabel.Position = UDim2.fromScale(0.5, 0.45)
	mainLabel.Size = UDim2.new(0.9, 0, 0, 70)
	mainLabel.BackgroundTransparency = 1
	mainLabel.Font = Enum.Font.GothamBold
	mainLabel.Text = "KHUB PANEL"
	mainLabel.TextColor3 = WHITE
	mainLabel.TextSize = 42
	mainLabel.TextTransparency = 1
	mainLabel.Parent = screenGui

	local subLabel = Instance.new("TextLabel")
	subLabel.AnchorPoint = Vector2.new(0.5, 0)
	subLabel.Position = UDim2.new(0.5, 0, 0.45, 40)
	subLabel.Size = UDim2.new(0.8, 0, 0, 24)
	subLabel.BackgroundTransparency = 1
	subLabel.Font = Enum.Font.Gotham
	subLabel.Text = "by Kyiel Pambid"
	subLabel.TextColor3 = MAIN_COLOR
	subLabel.TextSize = 16
	subLabel.TextTransparency = 1
	subLabel.Parent = screenGui

	local subLabel2 = Instance.new("TextLabel")
	subLabel2.AnchorPoint = Vector2.new(0.5, 0)
	subLabel2.Position = UDim2.new(0.5, 0, 0.45, 64)
	subLabel2.Size = UDim2.new(0.8, 0, 0, 20)
	subLabel2.BackgroundTransparency = 1
	subLabel2.Font = Enum.Font.Gotham
	subLabel2.Text = "Loading..."
	subLabel2.TextColor3 = Color3.fromRGB(180, 160, 220)
	subLabel2.TextSize = 13
	subLabel2.TextTransparency = 1
	subLabel2.Parent = screenGui

	local accentBar = Instance.new("Frame")
	accentBar.AnchorPoint = Vector2.new(0.5, 0)
	accentBar.Position = UDim2.new(0.5, 0, 0.45, 96)
	accentBar.Size = UDim2.fromOffset(0, 3)
	accentBar.BackgroundColor3 = MAIN_COLOR
	accentBar.BorderSizePixel = 0
	accentBar.Parent = screenGui

	local skipBtn = Instance.new("TextButton")
	skipBtn.AnchorPoint = Vector2.new(1, 1)
	skipBtn.Position = UDim2.new(1, -20, 1, -20)
	skipBtn.Size = UDim2.fromOffset(90, 34)
	skipBtn.BackgroundColor3 = Color3.fromRGB(30, 20, 50)
	skipBtn.Text = "SKIP"
	skipBtn.TextColor3 = WHITE
	skipBtn.Font = Enum.Font.GothamBold
	skipBtn.TextSize = 14
	skipBtn.AutoButtonColor = true
	skipBtn.Parent = screenGui
	Instance.new("UICorner", skipBtn).CornerRadius = UDim.new(0, 8)

	local blur = Instance.new("BlurEffect")
	blur.Size = 0
	blur.Parent = Lighting

	local introSound = Instance.new("Sound")
	introSound.Name = "KHUBIntroSound"
	introSound.SoundId = "rbxassetid://" .. tostring(SOUND_ID)
	introSound.Volume = 0.7
	introSound.Looped = false
	introSound.Parent = SoundService

	local skipped = false
	local function cleanup()
		pcall(function() introSound:Stop() end)
		pcall(function() introSound:Destroy() end)
		pcall(function() blur:Destroy() end)
		pcall(function() screenGui:Destroy() end)
	end

	skipBtn.MouseButton1Click:Connect(function()
		skipped = true
		cleanup()
	end)

	-- play sound from 10s mark (same as Dandy / Timebomb)
	pcall(function()
		introSound:Play()
		introSound.TimePosition = 10
	end)

	TweenService:Create(darkOverlay, TweenInfo.new(0.4), { BackgroundTransparency = 0.35 }):Play()
	TweenService:Create(overlay, TweenInfo.new(0.5), { BackgroundTransparency = 0.15 }):Play()
	TweenService:Create(blur, TweenInfo.new(0.5), { Size = 12 }):Play()
	task.wait(0.25)
	if skipped then return end

	TweenService:Create(mainLabel, TweenInfo.new(0.45), { TextTransparency = 0 }):Play()
	task.wait(0.2)
	if skipped then return end
	TweenService:Create(subLabel, TweenInfo.new(0.4), { TextTransparency = 0.05 }):Play()
	TweenService:Create(subLabel2, TweenInfo.new(0.4), { TextTransparency = 0.15 }):Play()
	TweenService:Create(accentBar, TweenInfo.new(0.55, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
		Size = UDim2.fromOffset(280, 3),
	}):Play()

	task.wait(1.6)
	if skipped then return end

	-- fade out
	local fade = TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(mainLabel, fade, { TextTransparency = 1 }):Play()
	TweenService:Create(subLabel, fade, { TextTransparency = 1 }):Play()
	TweenService:Create(subLabel2, fade, { TextTransparency = 1 }):Play()
	TweenService:Create(accentBar, fade, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(overlay, fade, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(darkOverlay, fade, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(blur, TweenInfo.new(0.7), { Size = 0 }):Play()
	pcall(function()
		TweenService:Create(introSound, TweenInfo.new(0.8), { Volume = 0 }):Play()
	end)
	task.wait(0.85)
	cleanup()
end

-- run intro (blocking until done or skipped)
pcall(playKHUBIntro)
```

