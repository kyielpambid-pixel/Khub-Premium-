-- Hitbox
local function clearHitbox(char)
	if not char then return end
	if hitboxData[char] then
		local data = hitboxData[char]
		if data.parts then
			for part, orig in pairs(data.parts) do
				if part and part.Parent then
					pcall(function()
						part.Size = orig.Size
						part.Transparency = orig.Transparency
						part.Massless = orig.Massless
						part.CanCollide = orig.CanCollide
					end)
				end
			end
		end
		hitboxData[char] = nil
	end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hrp then
		local vis = hrp:FindFirstChild("KHUB_HitboxVis")
		if vis then vis:Destroy() end
	end
end

local function applyHitboxV1(char)
	if not char or not char.Parent then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	clearHitbox(char)
	local size = math.clamp(hitboxSize, 3, 13)
	local partsBackup = {}
	for _, name in ipairs(EXPAND_PARTS) do
		local part = char:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			partsBackup[part] = {
				Size = part.Size,
				Transparency = part.Transparency,
				Massless = part.Massless,
				CanCollide = part.CanCollide,
			}
			pcall(function()
				if part.Name == "Head" then
					part.Size = Vector3.new(size * 0.85, size * 0.85, size * 0.85)
					part.Transparency = transparentHitbox and 0.15 or part.Transparency
				elseif part.Name == "HumanoidRootPart" then
					part.Size = Vector3.new(size, size * 1.1, size)
					part.Transparency = 1
					part.CanCollide = false
				else
					local o = partsBackup[part].Size
					local scale = size / 2
					part.Size = Vector3.new(
						math.max(o.X * scale, size * 0.4),
						math.max(o.Y * scale, size * 0.5),
						math.max(o.Z * scale, size * 0.4)
					)
					part.Transparency = transparentHitbox and 0.85 or part.Transparency
					part.CanCollide = false
				end
				part.Massless = true
			end)
		end
	end
	local vis = Instance.new("Part")
	vis.Name = "KHUB_HitboxVis"
	vis.Shape = Enum.PartType.Cylinder
	vis.Size = Vector3.new(0.15, size * 1.15, size * 1.15)
	vis.Color = Color3.fromRGB(255, 170, 50)
	vis.Material = Enum.Material.Neon
	vis.Transparency = 0.55
	vis.Anchored = true
	vis.CanCollide = false
	vis.CastShadow = false
	vis.Parent = hrp
	hitboxData[char] = { parts = partsBackup, vis = vis }
end

local function applyHitboxV2(plr)
	local char = plr.Character
	if not char then return end
	clearHitbox(char)
	local map = {
		Head = hitboxTorso, HumanoidRootPart = hitboxTorso, Torso = hitboxTorso,
		UpperTorso = hitboxTorso, LowerTorso = hitboxTorso,
		["Left Arm"] = hitboxArms, ["Right Arm"] = hitboxArms,
		LeftUpperArm = hitboxArms, RightUpperArm = hitboxArms,
		LeftLowerArm = hitboxArms, RightLowerArm = hitboxArms,
		["Left Leg"] = hitboxLegs, ["Right Leg"] = hitboxLegs,
		LeftUpperLeg = hitboxLegs, RightUpperLeg = hitboxLegs,
		LeftLowerLeg = hitboxLegs, RightLowerLeg = hitboxLegs,
	}
	local partsBackup = {}
	for name, sz in pairs(map) do
		local part = char:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			partsBackup[part] = {
				Size = part.Size,
				Transparency = part.Transparency,
				Massless = part.Massless,
				CanCollide = part.CanCollide,
			}
			part.Size = Vector3.new(sz, sz, sz)
			part.Transparency = 1
			part.CanCollide = false
			pcall(function()
				part.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
			end)
		end
	end
	hitboxData[char] = { parts = partsBackup }
end

