RunService.RenderStepped:Connect(function()
	if not tpWalk then return end
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp or hum.FloorMaterial == Enum.Material.Air then return end
	local md = hum.MoveDirection
	if md.Magnitude > 0 then
		local sp = hum.WalkSpeed * math.clamp(tpWalkMult, 0.1, 5)
		local v = hrp.AssemblyLinearVelocity
		hrp.AssemblyLinearVelocity = v:Lerp(Vector3.new(md.X * sp, v.Y, md.Z * sp), 0.5)
	end
end)

local function setFPSBoostV1(on)
	fpsV1 = on
	if on then
		savedLighting.Quality = settings().Rendering.QualityLevel
		pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
		Lighting.GlobalShadows = false
		Lighting.FogEnd = 9e9
	else
		pcall(function()
			if savedLighting.Quality then settings().Rendering.QualityLevel = savedLighting.Quality end
		end)
		Lighting.GlobalShadows = true
	end
end

local function setFPSBoostV2(on)
	fpsV2 = on
	if on then
		setFPSBoostV1(true)
		pcall(function()
			Lighting.Technology = Enum.Technology.Legacy
			Workspace.Terrain.Decoration = false
		end)
		for _, v in ipairs(Workspace:GetDescendants()) do
			if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then
				v.Enabled = false
			end
		end
	else
		setFPSBoostV1(false)
	end
end


