local function cleanKey(raw)
	local t = tostring(raw or "")
	t = string.gsub(t, "^%s+", "")
	t = string.gsub(t, "%s+$", "")
	t = string.gsub(t, "[\r\n\t]", "")
	return t
end

local function keysEqual(a, b)
	return cleanKey(a) == cleanKey(b)
end

