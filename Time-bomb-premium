				near = true
				break
			end
		end
	end
	if not near then return end
	flickBusy = true
	task.spawn(function()
		if autoFlickMode == "Mode 1" then
			hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(180), 0)
			task.wait(0.02)
			hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(-180), 0)
		else
			local cf = Camera.CFrame
			Camera.CFrame = cf * CFrame.Angles(0, math.rad(90), 0)
			task.wait(0.03)
			Camera.CFrame = cf
		end
		flickBusy = false
	end)
end)

-- Wallhop
local function nearWall(hrp)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { LocalPlayer.Character }
	params.IgnoreWater = true
	for _, dir in ipairs({
		hrp.CFrame.LookVector, -hrp.CFrame.LookVector,
		hrp.CFrame.RightVector, -hrp.CFrame.RightVector,
	}) do
		local hit = Workspace:Raycast(hrp.Position, dir * 2.2, params)
		if hit and hit.Instance and hit.Instance.CanCollide and hit.Instance.Transparency < 1 then
			return true
		end
	end
	return false
end

