local function triggerDoubleDeck(character, startCF, targetCF)
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then return end

	deckCooldown = true

	for _ = 1, WARMUP_JUMPS do
		if not humanoid.Parent then
			deckCooldown = false
			return
		end
		humanoid.Jump = true
		root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 60, root.AssemblyLinearVelocity.Z)
		task.wait(WARMUP_DELAY)
	end

	root.AssemblyLinearVelocity = Vector3.new(0, 70, 0)
	task.wait(0.15)

	local startPos = root.Position
	local targetPos = targetCF.Position
	local targetRotation = targetCF - targetCF.Position
	local steps = 15
	for i = 1, steps do
		if not root.Parent then break end
		local alpha = i / steps
		local currentPos = startPos:Lerp(targetPos, alpha)
		root.CFrame = CFrame.new(currentPos) * targetRotation
		root.AssemblyAngularVelocity = Vector3.zero
		root.AssemblyLinearVelocity = Vector3.zero
		task.wait(SLIDE_TIME / steps)
	end

	if root.Parent and humanoid.Parent then
		root.CFrame = targetCF
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		humanoid:ChangeState(Enum.HumanoidStateType.Landed)
	end

	task.wait(COOLDOWN_TIME)
	deckCooldown = false
end

RunService.Heartbeat:Connect(function()
