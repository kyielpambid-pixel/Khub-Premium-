local function hookPlayerHitbox(plr)
	if plr == LocalPlayer then return end
	plr.CharacterAdded:Connect(function(char)
		task.spawn(function()
			if not waitCharReady(char, 8) then return end
			if hitboxEnabled and ScriptAlive then
				if hitboxMode == "V1" then
					applyHitboxV1(char)
				else
					applyHitboxV2(plr)
				end
			end
		end)
	end)
	-- already alive
	if plr.Character and hitboxEnabled then
		task.spawn(function()
			if waitCharReady(plr.Character, 8) then
				if hitboxMode == "V1" then
					applyHitboxV1(plr.Character)
				else
					applyHitboxV2(plr)
				end
			end
		end)
	end
end

