	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not (root and humanoid) then return end

	local isStopped = humanoid.MoveDirection.Magnitude < 0.05 and root.AssemblyLinearVelocity.Magnitude < 1.5
	if not isStopped then return end

	if zone1Enabled and (root.Position - zone1_start.Position).Magnitude <= 3.0 then
		triggerDoubleDeck(char, zone1_start, zone1_target)
	elseif zone2Enabled and (root.Position - zone2_start.Position).Magnitude <= 3.0 then
		triggerDoubleDeck(char, zone2_start, zone2_target)
	end
end)

