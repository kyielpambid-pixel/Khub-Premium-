local function applyBombESP(obj)
	if not bombESP or not obj or not obj.Parent then return end
	if not isBombLike(obj) then return end
	local adornee = getBombAdornee(obj)
	if not adornee then return end

	-- already tracking and still valid
	local existing = bombEspObjects[obj]
	if existing and existing.bb and existing.bb.Parent and existing.bb.Adornee == adornee then
		return
	end
	clearBombESP(obj)

	local folder = getBombEspFolder()
	local bb = Instance.new("BillboardGui")
	bb.Name = "BombESP"
	bb.Adornee = adornee
