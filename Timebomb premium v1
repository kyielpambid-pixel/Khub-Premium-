local function scanBombs()
	if not bombESP then return end
	local seen = {}

	-- equipped / backpack tools
	for _, plr in ipairs(Players:GetPlayers()) do
		local function scanContainer(container)
			if not container then return end
			for _, child in ipairs(container:GetChildren()) do
				if isBombLike(child) then
					seen[child] = true
					applyBombESP(child)
				end
			end
		end
		if plr.Character then scanContainer(plr.Character) end
		pcall(function() scanContainer(plr:FindFirstChild("Backpack")) end)
	end

	-- workspace dropped bombs (deep-ish scan)
	local function scanDesc(root, depth)
		if depth > 4 or not root then return end
		for _, obj in ipairs(root:GetChildren()) do
			if isBombLike(obj) then
				seen[obj] = true
				applyBombESP(obj)
			end
			if obj:IsA("Folder") or obj:IsA("Model") then
				scanDesc(obj, depth + 1)
			end
		end
	end
	scanDesc(Workspace, 0)

	-- cleanup gone objects
	for obj in pairs(bombEspObjects) do
		if not seen[obj] or not obj.Parent then
			clearBombESP(obj)
		end
	end
end

