-- Wallhop (fixed V1 — longer rays, multi-height, force jump)
local function nearWall(hrp)
	if not hrp then return false end
	local char = LocalPlayer.Character
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char }
	params.IgnoreWater = true
	local dirs = {
		hrp.CFrame.LookVector, -hrp.CFrame.LookVector,
		hrp.CFrame.RightVector, -hrp.CFrame.RightVector,
	}
	local origins = {
		hrp.Position,
		hrp.Position + Vector3.new(0, 1.5, 0),
		hrp.Position + Vector3.new(0, -1.2, 0),
	}
	for _, origin in ipairs(origins) do
		for _, dir in ipairs(dirs) do
			local hit = Workspace:Raycast(origin, dir * 3.5, params)
			if hit and hit.Instance and hit.Instance.CanCollide then
				return true
			end
		end
	end
	return false
end

