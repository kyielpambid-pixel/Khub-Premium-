local function waitCharReady(char, timeout)
	timeout = timeout or 6
	local t0 = os.clock()
	while os.clock() - t0 < timeout do
		if not char or not char.Parent then return false end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hrp and hum then
			task.wait(0.2)
			return true
		end
		task.wait(0.05)
	end
	return char ~= nil and char:FindFirstChild("HumanoidRootPart") ~= nil
end

local function applyHeadless(char)
	if not char then return end
	local head = char:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		head.Transparency = 1
		for _, d in ipairs(head:GetDescendants()) do
			if d:IsA("Decal") or d:IsA("Texture") then
				d.Transparency = 1
			end
		end
	end
	for _, acc in ipairs(char:GetChildren()) do
		if acc:IsA("Accessory") then
			local n = string.lower(acc.Name)
			if n:find("hair") or n:find("hat") or n:find("face") or n:find("head")
				or n:find("hood") or n:find("hairline") or n:find("bundle") then
				for _, p in ipairs(acc:GetDescendants()) do
					if p:IsA("BasePart") then
						p.Transparency = 1
					elseif p:IsA("Decal") or p:IsA("Texture") then
						p.Transparency = 1
					end
				end
			end
		end
	end
end

