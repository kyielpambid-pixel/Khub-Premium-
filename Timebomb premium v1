local function isBombLike(obj)
	if not obj or not obj.Parent then return false end
	local classOk = obj:IsA("Tool") or obj:IsA("Model") or obj:IsA("BasePart")
	if not classOk then return false end
	-- skip character body parts
	if obj:IsA("BasePart") then
		local n0 = obj.Name
		if n0 == "Head" or n0 == "Torso" or n0 == "HumanoidRootPart" or n0:find("Arm") or n0:find("Leg") or n0:find("Hand") or n0:find("Foot") then
			return false
		end
	end
	local n = string.lower(tostring(obj.Name))
	if n:find("bomb", 1, true) or n:find("tnt", 1, true)
		or n:find("dynamite", 1, true) or n:find("explosive", 1, true)
		or n:find("timebomb", 1, true) or n:find("grenade", 1, true)
		or n:find("c4", 1, true) then
		return true
	end
	-- any Tool in this game is typically the bomb
	if obj:IsA("Tool") then
		return true
	end
	return false
end

local function getBombAdornee(obj)
	if not obj then return nil end
	if obj:IsA("BasePart") then return obj end
	if obj:IsA("Tool") or obj:IsA("Model") then
		local handle = obj:FindFirstChild("Handle")
		if handle and handle:IsA("BasePart") then return handle end
		if obj:IsA("Model") and obj.PrimaryPart then return obj.PrimaryPart end
		return obj:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

local function clearBombESP(obj)
	local data = bombEspObjects[obj]
	if data then
		pcall(function() if data.bb then data.bb:Destroy() end end)
		pcall(function() if data.hl then data.hl:Destroy() end end)
